# Required OpenAI-compatible endpoint and model. No provider is configured by default.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=your-model-name

# Optional. Never commit a real key.
LLM_API_KEY=

# Exact comma-separated endpoints the web UI may select. LLM_BASE_URL is always allowed.
LLM_ALLOWED_BASE_URLS=http://127.0.0.1:11434/v1

# Safe local-only defaults. Put authentication and TLS in a reverse proxy before LAN exposure.
APP_HOST=127.0.0.1
APP_PORT=8000
APP_RELOAD=false
APP_CORS_ORIGINS=

# Optional model behavior.
LLM_API_STYLE=openai
LLM_SUPPORTS_ATTACHMENTS=false
LLM_ATTACHMENT_MODE=auto
LLM_TIMEOUT_SECONDS=900
LLM_MAX_TOKENS=4096
LLM_MAX_TOKENS_THINKING=8192
LLM_THINKING_DEFAULT_ENABLED=false
